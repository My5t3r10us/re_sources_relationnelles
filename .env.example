# =============================================================================
# .env.example
# -----------------------------------------------------------------------------
# Variables d'environnement de l'application. Copiez ce fichier vers `.env`
# pour le développement local :
#
#   cp .env.example .env
#
# En déploiement, ces valeurs sont fournies par Dokploy et ne doivent JAMAIS
# être committées. Pour les tests, voir `.env.test.example`.
# =============================================================================

# -----------------------------------------------------------------------------
# Base de données (REQUIS)
# -----------------------------------------------------------------------------
# Lue par `db/index.ts` et `drizzle.config.ts`. Les migrations sont appliquées
# au démarrage du conteneur (`railpack.json` → `bun run db:migrate`).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/resources

# -----------------------------------------------------------------------------
# Authentification (REQUIS)
# -----------------------------------------------------------------------------
# Secret de signature des sessions better-auth. 32 caractères minimum.
# Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=changez-moi-32-caracteres-minimum

# URL publique sur laquelle better-auth construit ses callbacks.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Stockage objet S3 (REQUIS pour l'envoi de fichiers)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=resources
AWS_REGION=auto
AWS_ENDPOINT_URL_S3=https://t3.storage.dev

# Base des URL publiques des objets. Lue à la CONSTRUCTION par `next.config.ts`
# (`images.remotePatterns`) : elle doit donc être présente au build, pas
# seulement à l'exécution, sinon l'optimiseur d'images retombe sur la valeur
# par défaut.
AWS_PUBLIC_URL=https://resources.t3.tigrisfiles.io

# -----------------------------------------------------------------------------
# Maintenance (RGPD)
# -----------------------------------------------------------------------------
# Secret partagé protégeant `POST /api/v1/maintenance/purge-auth-log`, appelée
# par la tâche planifiée. Sans cette variable, la route refuse tout appel.
# Générer avec : openssl rand -hex 32
CRON_SECRET=

# Durée de conservation du journal d'authentification, en jours.
# Défaut : 180 (recommandation CNIL sur les journaux de connexion).
AUTH_LOG_RETENTION_DAYS=180

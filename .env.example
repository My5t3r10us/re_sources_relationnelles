# =============================================================================
# .env.example
# -----------------------------------------------------------------------------
# Variables d'environnement de l'application. Copiez ce fichier vers `.env`
# pour le développement local :
#
#   cp .env.example .env
#
# En déploiement, ces valeurs sont fournies par Dokploy et ne doivent JAMAIS
# être committées. Pour les tests, voir `.env.test.example`.
# =============================================================================

# -----------------------------------------------------------------------------
# Base de données (REQUIS)
# -----------------------------------------------------------------------------
# Lue par `db/index.ts` et `drizzle.config.ts`. Les migrations sont appliquées
# au démarrage du conteneur (`railpack.json` → `bun run db:migrate`).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/resources

# -----------------------------------------------------------------------------
# Authentification (REQUIS)
# -----------------------------------------------------------------------------
# Secret de signature des sessions better-auth. 32 caractères minimum.
# Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=changez-moi-32-caracteres-minimum

# URL publique sur laquelle better-auth construit ses callbacks.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Stockage objet S3 (REQUIS pour l'envoi de fichiers)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=resources
AWS_REGION=auto
AWS_ENDPOINT_URL_S3=https://t3.storage.dev

# Base des URL publiques des objets. Lue à la CONSTRUCTION par `next.config.ts`
# (`images.remotePatterns`) : elle doit donc être présente au build, pas
# seulement à l'exécution, sinon l'optimiseur d'images retombe sur la valeur
# par défaut.
AWS_PUBLIC_URL=https://resources.t3.tigrisfiles.io

# -----------------------------------------------------------------------------
# Maintenance (RGPD)
# -----------------------------------------------------------------------------
# Secret partagé protégeant `POST /api/v1/maintenance/purge-auth-log`, appelée
# par la tâche planifiée. Sans cette variable, la route refuse tout appel.
# Générer avec : openssl rand -hex 32
CRON_SECRET=

# Durée de conservation du journal d'authentification, en jours.
# Défaut : 180 (recommandation CNIL sur les journaux de connexion).
AUTH_LOG_RETENTION_DAYS=180

# -----------------------------------------------------------------------------
# Portail de retours Fider (OPTIONNEL)
# -----------------------------------------------------------------------------
# Sans ces variables, le bouton « Proposer une amélioration » du pied de page
# n'est pas rendu et `POST /api/v1/feedback` répond 503 : l'application
# fonctionne exactement comme avant.

# URL de l'instance Fider vue DEPUIS LE SERVEUR. Peut être une adresse interne.
FIDER_URL=

# Clé d'API Fider. Elle appartient à un compte collaborateur et autorise
# l'écriture sur tout le portail : elle ne doit JAMAIS être exposée au
# navigateur, d'où l'absence de préfixe `NEXT_PUBLIC_`.
# À générer depuis Fider : Site Settings → API.
FIDER_API_KEY=

# URL PUBLIQUE du portail, utilisée par le navigateur pour construire les liens
# vers les publications. Lue côté client, donc préfixée `NEXT_PUBLIC_`.
NEXT_PUBLIC_FIDER_URL=

# -----------------------------------------------------------------------------
# Supervision OneUptime (OPTIONNEL)
# -----------------------------------------------------------------------------
# La télémétrie ne démarre que si l'URL ET le jeton sont renseignés. Sans eux,
# `instrumentation.ts` n'initialise aucun SDK et `captureError` se contente
# d'écrire dans le journal serveur.

# Racine OTLP de l'instance OneUptime, SANS `/v1/traces` ni `/v1/logs` :
# l'application ajoute ces suffixes elle-même.
ONEUPTIME_OTLP_ENDPOINT=

# Jeton d'ingestion du service OneUptime, transmis en en-tête `x-oneuptime-token`.
ONEUPTIME_OTLP_TOKEN=

# Nom du service affiché dans OneUptime. Défaut : resources-relationnelles.
ONEUPTIME_SERVICE_NAME=

# -----------------------------------------------------------------------------
# Seed (OPTIONNEL)
# -----------------------------------------------------------------------------
# `db/seed.ts` détecte l'environnement : hors production il vide la base et
# insère le jeu de démonstration complet ; en production il n'efface rien et
# n'insère que les catégories, les ressources et un compte administrateur qui
# les porte, dont le mot de passe aléatoire est affiché une seule fois.
#
# Force le mode : "production" (contenu seul) ou "demo" (jeu complet).
# À renseigner en préproduction, que rien ne distingue de la production.
SEED_MODE=

# Adresse du compte administrateur créé en mode production.
# Défaut : contenu@ressources.local
SEED_ADMIN_EMAIL=

# Mot de passe commun aux comptes de démonstration (mode demo uniquement).
# Défaut : SeedPassword123!
SEED_PASSWORD=
